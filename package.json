{
  "name": "airlink-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Supervision de deux sources d'énergie et de deux charges : API, historique d'événements et interface.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "simulate": "tsx src/simulator/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
